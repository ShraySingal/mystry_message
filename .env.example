# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mystry_message?retryWrites=true&w=majority

# NextAuth Secret (Generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# Resend API Key for sending verification emails
RESEND_API_KEY=re_your_resend_api_key_here

# OpenAI API Key (Optional for AI suggestions)
OPENAI_API_KEY=your_openai_api_key_here
